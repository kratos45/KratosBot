# Required: create an API key in the Groq console.
GROQ_API_KEY=replace_with_your_groq_api_key

# Model and API endpoint. GPT-OSS 20B is the default.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Generation settings
KRATOSBOT_TEMPERATURE=0.7
KRATOSBOT_SUMMARY_TEMPERATURE=0.2

# Memory settings: keep 4 recent turns and summarize once history reaches 12 messages.
KRATOSBOT_MAX_RECENT_TURNS=4
KRATOSBOT_SUMMARIZE_AFTER_MESSAGES=12

# Session safety limit. Set to 0 to disable the local cumulative-token limit.
KRATOSBOT_MAX_TOTAL_TOKENS=10000

# USD per 1 million tokens. Check Groq's current pricing before relying on estimates.
GROQ_INPUT_USD_PER_MILLION=0.075
GROQ_OUTPUT_USD_PER_MILLION=0.30

# Local SQLite database and HTTP timeout.
KRATOSBOT_DATABASE_PATH=data/kratosbot.sqlite3
KRATOSBOT_REQUEST_TIMEOUT=60
